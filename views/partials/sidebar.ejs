<aside class="sidebar" id="sidebar">
    <a class="brand" href="/" aria-label="CloudPulse Home">
        <div class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
        </div>
        <div class="brand-text">
            <span class="brand-name">Cloud<span class="brand-accent">Pulse</span></span>
            <span class="brand-tagline">MULTI-CLOUD MONITOR</span>
        </div>
    </a>

    <div class="nav-section-label">MONITORING</div>

    <nav class="side-nav">
        <a class="nav-item <%= activePage === 'overview' ? 'active' : '' %>" href="/">
            <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="9"></rect>
                    <rect x="14" y="3" width="7" height="5"></rect>
                    <rect x="14" y="12" width="7" height="9"></rect>
                    <rect x="3" y="16" width="7" height="5"></rect>
                </svg>
            </span>
            <span>Overview</span>
        </a>

        <a class="nav-item <%= activePage === 'providers' ? 'active' : '' %>" href="/providers">
            <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
                </svg>
            </span>
            <span>Cloud Providers</span>
            <span class="nav-badge" id="sidebarProviderBadge">3</span>
        </a>

        <a class="nav-item <%= activePage === 'resources' ? 'active' : '' %>" href="/resources">
            <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                    <line x1="6" y1="6" x2="6.01" y2="6"></line>
                    <line x1="6" y1="18" x2="6.01" y2="18"></line>
                </svg>
            </span>
            <span>Resources</span>
        </a>

        <a class="nav-item <%= activePage === 'metrics' ? 'active' : '' %>" href="/metrics">
            <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
            </span>
            <span>Metrics & Analytics</span>
        </a>

        <a class="nav-item <%= activePage === 'alerts' ? 'active' : '' %>" href="/alerts">
            <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
            </span>
            <span>Alerts & Notifications</span>
            <span class="nav-alert-badge" id="sidebarAlertBadge" style="display: none;">0</span>
        </a>

        <div class="nav-section-label" style="margin-top: 1.5rem;">CONFIGURATION</div>

        <a class="nav-item <%= activePage === 'settings' ? 'active' : '' %>" href="/settings">
            <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
            </span>
            <span>Settings & Setup</span>
        </a>
    </nav>

    <div class="sidebar-bottom">
        <div class="connection-status-pill">
            <span class="status-pulse-dot" id="systemPulseDot"></span>
            <div>
                <div class="conn-title">Monitoring Service</div>
                <div class="conn-sub" id="sidebarServiceStatus">Active · Polling</div>
            </div>
        </div>

        <div class="sidebar-meta">
            <span>CloudPulse v1.0.0</span>
            <span class="meta-dot">·</span>
            <span>AWS / Azure / GCP</span>
        </div>
    </div>
</aside>
