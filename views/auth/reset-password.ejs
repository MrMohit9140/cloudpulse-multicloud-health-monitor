<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
            padding: 1.5rem;
        }
        .auth-card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-lg);
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
        }
        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .auth-header .brand {
            display: inline-flex;
            justify-content: center;
            padding: 0;
            border: none;
            margin-bottom: 1rem;
        }
        .auth-title {
            font-size: 1.45rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.35rem;
        }
        .auth-subtitle {
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .form-group {
            margin-bottom: 1.25rem;
        }
        .form-label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.4rem;
        }
        .form-input {
            width: 100%;
            padding: 0.65rem 0.85rem;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-md);
            font-size: 0.9rem;
            color: var(--text-primary);
            background-color: var(--bg-surface);
            transition: all 0.15s ease;
        }
        .form-input:focus {
            outline: none;
            border-color: var(--brand-primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }
        .auth-link {
            color: var(--brand-primary);
            text-decoration: none;
            font-weight: 600;
        }
        .auth-link:hover {
            text-decoration: underline;
        }
        .auth-alert {
            padding: 0.75rem 1rem;
            border-radius: var(--radius-md);
            font-size: 0.82rem;
            margin-bottom: 1.25rem;
            display: none;
        }
        .auth-alert.error {
            background-color: var(--status-critical-bg);
            border: 1px solid #fecaca;
            color: #b91c1c;
            display: block;
        }
        .auth-alert.success {
            background-color: var(--status-healthy-bg);
            border: 1px solid #a7f3d0;
            color: #065f46;
            display: block;
        }
        .auth-footer {
            text-align: center;
            margin-top: 1.75rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border-subtle);
            font-size: 0.82rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <a class="brand" href="/" aria-label="CloudPulse Home">
                    <div class="brand-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                        </svg>
                    </div>
                    <div class="brand-text" style="text-align: left;">
                        <span class="brand-name" style="color: var(--text-primary);">Cloud<span class="brand-accent">Pulse</span></span>
                        <span class="brand-tagline">OBSERVABILITY PLATFORM</span>
                    </div>
                </a>
                <h1 class="auth-title">Set new password</h1>
                <p class="auth-subtitle">Choose a secure password with at least 8 characters</p>
            </div>

            <div id="authAlert" class="auth-alert"></div>

            <form id="resetForm" novalidate>
                <input type="hidden" id="token" value="<%= token %>">

                <div class="form-group">
                    <label class="form-label" for="password">New Password</label>
                    <input type="password" id="password" class="form-input" placeholder="••••••••" required autocomplete="new-password" autofocus>
                </div>

                <div class="form-group">
                    <label class="form-label" for="confirmPassword">Confirm New Password</label>
                    <input type="password" id="confirmPassword" class="form-input" placeholder="••••••••" required autocomplete="new-password">
                </div>

                <button type="submit" class="btn btn-primary" id="submitBtn" style="width: 100%; justify-content: center; padding: 0.75rem;">
                    <span id="submitBtnText">Update Password & Continue</span>
                </button>
            </form>

            <div class="auth-footer">
                <a href="/login" class="auth-link">Back to sign in</a>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById("resetForm");
        const alertBox = document.getElementById("authAlert");
        const submitBtn = document.getElementById("submitBtn");
        const btnText = document.getElementById("submitBtnText");
        const token = document.getElementById("token").value;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            alertBox.style.display = "none";

            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            if (password.length < 8) {
                alertBox.textContent = "Password must be at least 8 characters long.";
                alertBox.className = "auth-alert error";
                alertBox.style.display = "block";
                return;
            }

            if (password !== confirmPassword) {
                alertBox.textContent = "Passwords do not match.";
                alertBox.className = "auth-alert error";
                alertBox.style.display = "block";
                return;
            }

            submitBtn.disabled = true;
            btnText.textContent = "Updating...";

            try {
                const res = await fetch("/api/auth/reset-password", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ token, password, confirmPassword })
                });

                const data = await res.json();

                if (data.success) {
                    alertBox.textContent = data.message;
                    alertBox.className = "auth-alert success";
                    alertBox.style.display = "block";
                    setTimeout(() => {
                        window.location.href = "/login?success=Password+updated+successfully.+Please+sign+in.";
                    }, 1500);
                } else {
                    alertBox.textContent = data.message || "Failed to reset password.";
                    alertBox.className = "auth-alert error";
                    alertBox.style.display = "block";
                    submitBtn.disabled = false;
                    btnText.textContent = "Update Password & Continue";
                }
            } catch (err) {
                alertBox.textContent = "Network error. Please try again.";
                alertBox.className = "auth-alert error";
                alertBox.style.display = "block";
                submitBtn.disabled = false;
                btnText.textContent = "Update Password & Continue";
            }
        });
    </script>
</body>
</html>
