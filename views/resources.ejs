<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
            background-color: var(--bg-surface);
            padding: 1rem 1.25rem;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-subtle);
        }
        .provider-pill-filter {
            display: flex;
            gap: 0.35rem;
        }
        .pill-btn {
            background: none;
            border: 1px solid var(--border-strong);
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .pill-btn:hover {
            background-color: var(--bg-surface-subtle);
        }
        .pill-btn.active {
            background-color: var(--brand-primary);
            color: white;
            border-color: var(--brand-primary);
        }
        .pagination-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.25rem;
            border-top: 1px solid var(--border-subtle);
            font-size: 0.82rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <div class="app-shell">
        <%- include("partials/sidebar") %>

        <main class="main-content">
            <%- include("partials/header") %>

            <div class="content-body">
                <div class="section-heading-row">
                    <div>
                        <h2 class="section-title">Centralized Resource Inventory</h2>
                        <p class="section-subtitle">Real-time inventory and health telemetry across AWS EC2, Azure VMs, and Google Compute Engine</p>
                    </div>
                </div>

                <!-- FILTER BAR -->
                <div class="filter-bar">
                    <div class="provider-pill-filter">
                        <button class="pill-btn active" data-provider="">All Providers</button>
                        <button class="pill-btn" data-provider="AWS">AWS</button>
                        <button class="pill-btn" data-provider="Azure">Azure</button>
                        <button class="pill-btn" data-provider="GCP">GCP</button>
                    </div>

                    <div class="filter-row">
                        <select id="statusFilter" class="filter-select">
                            <option value="">All Statuses</option>
                            <option value="healthy">Healthy (< 70%)</option>
                            <option value="warning">Warning (70% - 90%)</option>
                            <option value="critical">Critical (≥ 90%)</option>
                        </select>

                        <input type="text" id="resourceSearch" class="search-input" placeholder="Search resources, ID, region..." style="width: 240px;">
                    </div>
                </div>

                <!-- RESOURCE TABLE PANEL -->
                <div class="table-panel">
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Resource Name</th>
                                    <th>Provider</th>
                                    <th>Resource ID</th>
                                    <th>Type</th>
                                    <th>Region</th>
                                    <th>CPU Usage</th>
                                    <th>Memory</th>
                                    <th>Health</th>
                                    <th>Source</th>
                                    <th>Last Checked</th>
                                </tr>
                            </thead>
                            <tbody id="inventoryTableBody">
                                <tr>
                                    <td colspan="10" style="text-align: center; padding: 3rem;">Loading inventory...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination-bar">
                        <span id="paginationSummary">Showing 0 of 0 resources</span>
                        <div style="display: flex; gap: 0.5rem;">
                            <button class="btn btn-secondary" id="prevPageBtn" style="padding: 0.35rem 0.75rem;" disabled>← Prev</button>
                            <button class="btn btn-secondary" id="nextPageBtn" style="padding: 0.35rem 0.75rem;" disabled>Next →</button>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="app-footer">
                <span>CloudPulse – Multi-Cloud Infrastructure Health Monitor</span>
                <span>AWS · Azure · GCP Independent Monitoring Engine</span>
            </footer>
        </main>
    </div>

    <script src="/js/resources.js"></script>
</body>
</html>
