<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
            padding: 1.5rem;
        }
        .auth-card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-lg);
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
        }
        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .auth-header .brand {
            display: inline-flex;
            justify-content: center;
            padding: 0;
            border: none;
            margin-bottom: 1rem;
        }
        .auth-title {
            font-size: 1.45rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.35rem;
        }
        .auth-subtitle {
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.4;
        }
        .form-group {
            margin-bottom: 1.25rem;
        }
        .form-label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.4rem;
        }
        .form-input {
            width: 100%;
            padding: 0.65rem 0.85rem;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-md);
            font-size: 0.9rem;
            color: var(--text-primary);
            background-color: var(--bg-surface);
            transition: all 0.15s ease;
        }
        .form-input:focus {
            outline: none;
            border-color: var(--brand-primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }
        .auth-link {
            color: var(--brand-primary);
            text-decoration: none;
            font-weight: 600;
        }
        .auth-link:hover {
            text-decoration: underline;
        }
        .auth-alert {
            padding: 0.85rem 1rem;
            border-radius: var(--radius-md);
            font-size: 0.82rem;
            margin-bottom: 1.25rem;
            display: none;
            line-height: 1.4;
        }
        .auth-alert.error {
            background-color: var(--status-critical-bg);
            border: 1px solid #fecaca;
            color: #b91c1c;
            display: block;
        }
        .auth-alert.success {
            background-color: var(--status-healthy-bg);
            border: 1px solid #a7f3d0;
            color: #065f46;
            display: block;
        }
        .dev-box {
            background-color: #f1f5f9;
            border: 1px dashed var(--border-strong);
            border-radius: var(--radius-md);
            padding: 0.85rem;
            margin-top: 1rem;
            font-size: 0.78rem;
            color: var(--text-secondary);
            word-break: break-all;
        }
        .auth-footer {
            text-align: center;
            margin-top: 1.75rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border-subtle);
            font-size: 0.82rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <a class="brand" href="/" aria-label="CloudPulse Home">
                    <div class="brand-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                        </svg>
                    </div>
                    <div class="brand-text" style="text-align: left;">
                        <span class="brand-name" style="color: var(--text-primary);">Cloud<span class="brand-accent">Pulse</span></span>
                        <span class="brand-tagline">OBSERVABILITY PLATFORM</span>
                    </div>
                </a>
                <h1 class="auth-title">Reset your password</h1>
                <p class="auth-subtitle">Enter your account email to receive secure password recovery instructions</p>
            </div>

            <div id="authAlert" class="auth-alert"></div>
            <div id="devBox" class="dev-box" style="display: none;"></div>

            <form id="forgotForm" novalidate>
                <div class="form-group">
                    <label class="form-label" for="email">Account Email</label>
                    <input type="email" id="email" class="form-input" placeholder="name@company.com" required autocomplete="email" autofocus>
                </div>

                <button type="submit" class="btn btn-primary" id="submitBtn" style="width: 100%; justify-content: center; padding: 0.75rem;">
                    <span id="submitBtnText">Send Reset Link</span>
                </button>
            </form>

            <div class="auth-footer">
                Remembered your password? <a href="/login" class="auth-link">Return to sign in</a>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById("forgotForm");
        const alertBox = document.getElementById("authAlert");
        const devBox = document.getElementById("devBox");
        const submitBtn = document.getElementById("submitBtn");
        const btnText = document.getElementById("submitBtnText");

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            alertBox.style.display = "none";
            devBox.style.display = "none";

            const email = document.getElementById("email").value.trim();
            if (!email) {
                alertBox.textContent = "Please enter your email address.";
                alertBox.className = "auth-alert error";
                alertBox.style.display = "block";
                return;
            }

            submitBtn.disabled = true;
            btnText.textContent = "Generating...";

            try {
                const res = await fetch("/api/auth/forgot-password", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ email })
                });

                const data = await res.json();

                if (data.success) {
                    alertBox.textContent = data.message;
                    alertBox.className = "auth-alert success";
                    alertBox.style.display = "block";

                    if (data.devResetUrl) {
                        devBox.innerHTML = `<strong>Development Notice (No SMTP configured):</strong><br>Click this generated link to reset your password:<br><a href="${data.devResetUrl}" style="color: var(--brand-primary); font-weight: 600;">${data.devResetUrl}</a>`;
                        devBox.style.display = "block";
                    }

                    form.reset();
                } else {
                    alertBox.textContent = data.message || "Failed to process request.";
                    alertBox.className = "auth-alert error";
                    alertBox.style.display = "block";
                }
            } catch (err) {
                alertBox.textContent = "Network error. Please try again.";
                alertBox.className = "auth-alert error";
                alertBox.style.display = "block";
            } finally {
                submitBtn.disabled = false;
                btnText.textContent = "Send Reset Link";
            }
        });
    </script>
</body>
</html>
