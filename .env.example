# =================================================================
# CloudPulse – Multi-Cloud Health Monitor Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file with secrets to Git or GitHub!
# =================================================================

# Server & Application
PORT=9090
NODE_ENV=development
DEMO_MODE=true
BACKGROUND_MONITORING=true
MONITORING_INTERVAL_MS=60000

# MongoDB Atlas Database URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cloudpulse?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://dbUser:SamplePassword123@cluster0.example.mongodb.net/cloudpulse?retryWrites=true&w=majority

# CPU Alert Thresholds (in percentage)
THRESHOLD_CPU_WARNING=70.0
THRESHOLD_CPU_CRITICAL=90.0

# -----------------------------------------------------------------
# 1. Amazon Web Services (AWS) Configuration
# -----------------------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_EC2_INSTANCE_ID=i-01fb627927411c6f6

# -----------------------------------------------------------------
# 2. Microsoft Azure Configuration
# -----------------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=sample_azure_client_secret_value
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_VM_RESOURCE_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/SampleRG/providers/Microsoft.Compute/virtualMachines/SampleVM

# -----------------------------------------------------------------
# 3. Google Cloud Platform (GCP) Configuration
# -----------------------------------------------------------------
GCP_PROJECT_ID=sample-gcp-project-id
GCP_ZONE=us-central1-a
GCP_INSTANCE_ID=1234567890123456789

# For local development with a key file:
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json

# For Render / Production cloud deployment (paste entire JSON service account key as a single-line string):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"sample-gcp-project-id",...}
